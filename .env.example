# Settings of the LLM of CardioAgent-Ops. Copy this file to ".env" (same folder) and fill it there.
# .env is secret and never committed (.gitignore); this file .env.example has no real key.

# "groq", "xai" or "ollama" (local, slow, private). Empty = guessed from the key (gsk_ -> groq, xai- -> xai), else ollama
LLM_PROVIDER=
# paste your key here in .env (never in .env.example, never in git)
LLM_API_KEY=
# empty = the default of the provider (groq: https://api.groq.com/openai/v1, xai: https://api.x.ai/v1)
LLM_BASE_URL=
# the model name of the provider (empty = a fast default, see the README):
#   groq default: openai/gpt-oss-120b (chosen with GET /models: ~0.8 s per answer; also qwen/qwen3.8-27b)
#   xai default : grok-4-fast-non-reasoning (or grok-3-mini)
#   ollama      : qwen2.5:3b-instruct (cardio-llm = our fine-tuned model)
LLM_MODEL=
